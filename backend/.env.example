# Copy to .env and fill in. .env is git-ignored.

ENV=dev
API_HOST=0.0.0.0
API_PORT=8000

# Postgres (matches infra/docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://medicard:medicard@localhost:5432/medicard

# JWT — use at least 32 bytes; generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-to-a-long-random-value-at-least-32-bytes
JWT_ALG=HS256
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=30

# Admin review queue (sent as the X-Admin-Key header)
ADMIN_API_KEY=change-me-admin-dev-only
OTP_TTL_MIN=5
OTP_MAX_ATTEMPTS=5

# Object storage
STORAGE_BACKEND=s3           # s3 | local  (use "local" to skip MinIO in dev)
STORAGE_LOCAL_DIR=./_storage
# MinIO / S3 (matches infra/docker-compose.yml)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=medicard
S3_SECRET_KEY=medicard123
S3_BUCKET=medicard-records
S3_REGION=us-east-1

# Claude — required for extraction and AI summary (Phases 2 and 4)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
FAKE_EXTRACTION=false        # true = deterministic stub, no Claude call
FAKE_AI=false               # true = stub the advisory summary / Ask-AI

# Access grant lifetime
GRANT_TTL_HOURS=12
BREAK_GLASS_TTL_MINUTES=60

# FCM (Phase 3) — path to a firebase service account json, optional until then
FCM_CREDENTIALS_FILE=
